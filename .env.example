OPENROUTER_API_KEY=
# Optional: tracing is off when the public key is empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false.
DJANGO_SECRET_KEY=
LOG_LEVEL=INFO

# Host-side ports of the compose services, for running Django or tests outside Docker.
POSTGRES_PORT=55432
REDIS_URL=redis://localhost:6380/0
