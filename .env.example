OPENROUTER_API_KEY=
# Optional: tracing is off when the public key is empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

DJANGO_DEBUG=false
# Required when DJANGO_DEBUG is false: any long random string, e.g. the output of
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Hosts the app is served from (comma-separated); defaults to localhost,127.0.0.1.
# DJANGO_ALLOWED_HOSTS=
LOG_LEVEL=INFO

# Host-side ports of the compose services, for running Django or tests outside Docker.
POSTGRES_PORT=55432
REDIS_URL=redis://localhost:6380/0
